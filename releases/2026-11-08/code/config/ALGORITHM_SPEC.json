    "n_estimators": 1000, "bootstrap": true, "max_depth": null, "mtry_rules": ["ceil(sqrt(p))", "ceil(p/3)"],
    "sample_fractions": [0.632, 0.8], "min_samples_leaf": [32, 96], "terminal_chf": "nelson_aalen", "forest_chf": "arithmetic_mean_tree_chf"
  },
  "GBST": {
    "backend": "sksurv.ensemble.GradientBoostingSurvivalAnalysis", "backend_version": "0.28.0", "loss": "coxph", "candidate_n": 12,
    "max_depth": [1, 2, 3], "learning_rate": [0.03, 0.07], "n_estimators": [250, 500], "subsample": 0.8,
    "max_features": 1.0, "min_samples_leaf": 64, "early_stopping": false, "risk_baseline": "training_partition_breslow"
  },
  "selection_metric": "pooled_inner_native_180d_brier",
  "selection_tolerance": 1e-8
